#!/bin/sh
# PID 1 inside the TeOS Linux initrd.
BB=/bin/busybox
$BB mkdir -p /proc /sys /dev /tmp /run /stick /lib/modules
$BB mount -t proc proc /proc
$BB mount -t sysfs sys /sys
$BB mount -t devtmpfs dev /dev 2>/dev/null || true
log() { $BB printf 'teos: %s\n' "$*" >/dev/ttyS0 2>/dev/null || true; }
export HOME=/root
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
KVER=$(uname -r 2>/dev/null || echo 6.18.52-0-virt)
MOD=/lib/modules/$KVER/kernel
log "kver $KVER"
ins() {
  if [ -f "$1" ]; then
    $BB insmod "$1" 2>/dev/null || log "mod fail $($BB basename "$1")"
  else
    log "mod missing $1"
  fi
}
ins "$MOD/drivers/scsi/sd_mod.ko"
ins "$MOD/fs/nls/nls_cp437.ko"
ins "$MOD/fs/nls/nls_iso8859-1.ko"
ins "$MOD/fs/fat/fat.ko"
ins "$MOD/fs/fat/vfat.ko"
ins "$MOD/net/core/failover.ko"
ins "$MOD/drivers/net/net_failover.ko"
ins "$MOD/drivers/net/virtio_net.ko"
ins "$MOD/drivers/net/ethernet/intel/e1000/e1000.ko"
ins "$MOD/net/packet/af_packet.ko"
ins "$MOD/drivers/block/virtio_blk.ko"
ins "$MOD/drivers/usb/common/usb-common.ko"
ins "$MOD/drivers/usb/core/usbcore.ko"
ins "$MOD/drivers/usb/host/xhci-hcd.ko"
ins "$MOD/drivers/usb/host/xhci-pci.ko"
ins "$MOD/drivers/usb/storage/usb-storage.ko"
ins "$MOD/drivers/usb/storage/uas.ko"
ins "$MOD/drivers/block/loop.ko"
ins "$MOD/lib/crc/crc16.ko"
ins "$MOD/fs/mbcache.ko"
ins "$MOD/fs/jbd2/jbd2.ko"
ins "$MOD/fs/ext4/ext4.ko"
ins "$MOD/drivers/i2c/i2c-core.ko"
ins "$MOD/drivers/video/fbdev/core/fb.ko"
ins "$MOD/drivers/video/fbdev/core/fb_sys_fops.ko"
ins "$MOD/drivers/video/fbdev/core/syscopyarea.ko"
ins "$MOD/drivers/video/fbdev/core/sysfillrect.ko"
ins "$MOD/drivers/video/fbdev/core/sysimgblt.ko"
ins "$MOD/drivers/gpu/drm/drm_panel_orientation_quirks.ko"
ins "$MOD/drivers/gpu/drm/drm.ko"
ins "$MOD/drivers/gpu/drm/drm_kms_helper.ko"
ins "$MOD/drivers/gpu/drm/clients/drm_client_lib.ko"
ins "$MOD/drivers/gpu/drm/drm_shmem_helper.ko"
ins "$MOD/drivers/gpu/drm/sysfb/drm_sysfb_helper.ko"
ins "$MOD/drivers/gpu/drm/sysfb/simpledrm.ko"
ins "$MOD/drivers/gpu/drm/ttm/ttm.ko"
ins "$MOD/drivers/gpu/drm/drm_ttm_helper.ko"
ins "$MOD/drivers/gpu/drm/drm_vram_helper.ko"
ins "$MOD/drivers/gpu/drm/tiny/bochs.ko"
ins "$MOD/drivers/hid/hid.ko"
ins "$MOD/drivers/hid/hid-generic.ko"
ins "$MOD/drivers/hid/usbhid/usbhid.ko"
ins "$MOD/drivers/input/evdev.ko"
ins "$MOD/drivers/input/mousedev.ko"
# t2linux (GPL): keyboard/trackpad over BCE. Harmless if missing (QEMU).
ins "$MOD/drivers/staging/t2bce/t2bce_dma/t2bce_dma.ko"
ins "$MOD/drivers/staging/t2bce/t2bce_core/t2bce_core.ko"
ins "$MOD/drivers/staging/t2bce/t2bce_vhci/t2bce_vhci.ko"
ins "$MOD/drivers/hid/hid-apple.ko"
ins "$MOD/drivers/hid/hid-appletb-bl.ko"
ins "$MOD/drivers/hwmon/applesmc.ko"
$BB mdev -s 2>/dev/null || true
log "fb $($BB ls /dev/fb* 2>/dev/null)"
if grep -qw teos_smoke /proc/cmdline && [ -x /usr/local/bin/teos-gui ]; then
  /usr/local/bin/teos-gui smoke >/dev/ttyS0 2>&1 || log "gui smoke fail"
fi
log "net $($BB ls /sys/class/net 2>/dev/null)"
log "blk $($BB ls /dev/sd* /dev/vd* 2>/dev/null)"
mounted=
for d in /dev/vda1 /dev/vda /dev/sda1 /dev/sda /dev/sdb1 /dev/sdb; do
  if [ -b "$d" ]; then
    if $BB mount -t vfat -o rw,iocharset=iso8859-1 "$d" /stick 2>/tmp/mnt.err; then
      log "mounted $d"
      mounted=1
      break
    else
      log "mount fail $d $($BB cat /tmp/mnt.err 2>/dev/null)"
    fi
  fi
done
[ -n "$mounted" ] || log "no stick"
if [ -f /stick/APPS.IMG ]; then
  $BB mkdir -p /apps
  if $BB losetup /dev/loop0 /stick/APPS.IMG 2>/tmp/loop.err; then
    if $BB mount -t ext4 /dev/loop0 /apps 2>/tmp/amnt.err; then
      log "apps mounted"
    else
      log "apps mount fail $($BB cat /tmp/amnt.err 2>/dev/null)"
    fi
  else
    log "loop fail $($BB cat /tmp/loop.err 2>/dev/null)"
  fi
fi
export PATH=/apps/usr/bin:/apps/bin:$PATH
export LD_LIBRARY_PATH=/apps/usr/lib:/apps/lib
if [ -f /stick/NAME.TXT ]; then
  $BB cp /stick/NAME.TXT /etc/hostname
elif [ -f /stick/hostname ]; then
  $BB cp /stick/hostname /etc/hostname
fi
$BB hostname -F /etc/hostname 2>/dev/null || $BB hostname teos
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Net in the background so the home screen is instant.
(
  for n in $($BB ls /sys/class/net 2>/dev/null); do
    [ "$n" = "lo" ] && continue
    $BB ip link set "$n" up 2>/dev/null || true
    $BB udhcpc -i "$n" -n -q -t 2 -T 1 >/dev/null 2>&1 || true
  done
) &
cd /root
UI=/usr/local/bin/teos-ui
if [ -c /dev/ttyS0 ]; then
  exec $UI <>/dev/ttyS0 >&0 2>&1
fi
if [ -c /dev/console ]; then
  exec $UI <>/dev/console >&0 2>&1
fi
exec $UI
